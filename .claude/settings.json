{
  "permissions": {
    "deny": [
      "Bash(git add -A)",
      "Bash(git add -A:*)",
      "Bash(git add .)",
      "Bash(git add .:*)",
      "Bash(git add --all)",
      "Bash(git add --all:*)",
      "Bash(git commit -a:*)",
      "Bash(git commit --all:*)",
      "Bash(git push --force:*)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git worktree list:*)",
      "Bash(git remote -v:*)",
      "Bash(pnpm check:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(jq:*)"
    ]
  }
}
